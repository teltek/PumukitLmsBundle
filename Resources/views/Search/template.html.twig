{% extends '@PumukitWebTV/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('bundles/pumukitlms/css/lms.css') }}" type="text/css" rel="stylesheet">
{% endblock %}

{% block body_base %}
    <div class="col-12" data-controller="lms--search">
        <div class="row">
            <div class="col-12">
                {% if blocked_tag is defined and blocked_tag is not null %}
                    <h3 class="moodle_title">{{ blocked_tag.title }}</h3>
                {% else %}
                    <h3 class="moodle_title">
                        {% if template_title is defined %}
                            {{ "Search all videos" |trans }}
                        {% elseif type == "series" %}
                            {% trans %}Series search{% endtrans %}
                        {% else %}
                            {% trans %}Multimedia objects search{% endtrans %}
                        {% endif %}
                    </h3>
                {% endif %}
            </div>
        </div>
        <div class="row">
            {% include '@PumukitWebTV/Search/template_title.html.twig' %}
            {% include '@PumukitWebTV/Search/template_list.html.twig' %}
            {% include '@PumukitWebTV/Misc/pager.html.twig' %}
        </div>

        <div class="modal fade" id="sharedVideosModal" tabindex="-1" aria-labelledby="sharedVideosModalLabel" aria-hidden="true" data-lms--search-target="modal">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 class="moodle_title modal-title fs-5" id="sharedVideosModalLabel">{% trans %}Multimedia object preview{% endtrans %}</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body" data-lms--search-target="preview"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <button type="button" class="btn btn-primary" data-action="lms--search#publish">{{ 'Publish'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
